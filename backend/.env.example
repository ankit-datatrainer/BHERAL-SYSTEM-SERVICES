# Copy to .env and fill in.

NODE_ENV=development
PORT=4000

# Supabase project
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# PREFERRED: the service-role (secret) key from
# Supabase dashboard -> Project Settings -> API keys.
# It bypasses RLS, which is what a trusted server-side API wants.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fallback if you have not set a service-role key yet. The API then runs as
# `anon` and is limited by the RLS policies in the migrations.
SUPABASE_ANON_KEY=

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000
